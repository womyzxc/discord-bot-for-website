# Offcialx Anti-Nuke Bot Configuration v3.1
# Copy this file to .env and fill in your values

# ===== REQUIRED SETTINGS =====

# Discord Bot Token (Required)
# Get from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# Bot Command Prefix
BOT_PREFIX=!

# Bot Owner IDs (comma-separated for multiple owners)
OWNER_IDS=your_discord_id_here

# ===== DATABASE SETTINGS =====

# SQLite Database Path (for development - used if DATABASE_URL is not set)
DATABASE_PATH=data/offcialx.db

# PostgreSQL Database URL (RECOMMENDED for production)
# Set this to use PostgreSQL for persistent storage
# Format: postgresql://username:password@host:port/database
# Example for Railway: postgresql://postgres:password@containers-us-west-123.railway.app:5432/railway
# Example for local: postgresql://postgres:password@localhost:5432/offcialx
DATABASE_URL=postgresql://your_user:your_password@your_host:5432/your_database

# ===== API SETTINGS =====

# Enable Dashboard API (true/false)
ENABLE_API=true

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8080

# API Secret Key (for authentication)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=your_secret_key_here

# ===== ADVANCED SETTINGS =====

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Threat Intelligence Sharing (cross-server)
SHARE_THREAT_INTEL=true

# Advanced Detection Sensitivity (low/medium/high)
DETECTION_SENSITIVITY=medium

# Auto-mute duration for threats (seconds)
AUTO_MUTE_DURATION=3600

# ===== WEBHOOK NOTIFICATIONS =====

# Discord Webhook URL for security alerts (nuke attempts, raids, etc.)
# Create a webhook in your Discord server settings
SECURITY_WEBHOOK_URL=

# Discord Webhook URL for system status (bot online/offline, updates)
SYSTEM_WEBHOOK_URL=

# ===== SCHEDULED TASKS =====

# Enable automatic backups (true/false)
ENABLE_AUTO_BACKUP=true

# Backup interval in hours (default: 6)
BACKUP_INTERVAL_HOURS=6

# Maximum backup age in days (older backups are deleted)
MAX_BACKUP_AGE_DAYS=30

# ===== VPN/PROXY DETECTION =====

# ProxyCheck.io API Key (recommended, free tier available)
# Get from: https://proxycheck.io/
PROXYCHECK_API_KEY=

# AbuseIPDB API Key (optional, enhances detection)
# Get from: https://www.abuseipdb.com/
ABUSEIPDB_API_KEY=

# IPInfo API Key (optional, for IP geolocation)
# Get from: https://ipinfo.io/
IPINFO_API_KEY=
